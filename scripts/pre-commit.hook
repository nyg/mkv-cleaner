#!/usr/bin/env bash
# scripts/pre-commit.hook
# This file is tracked by git. Install it with: bash scripts/install-hooks.sh

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
SOURCE="prompts/mkv-cleaner.md"

if git diff --cached --name-only | grep -q "^${SOURCE}$"; then
  echo "[pre-commit] $SOURCE changed — syncing derived files..."
  bash "$REPO_ROOT/scripts/sync-prompts.sh"
  git add "$REPO_ROOT/CLAUDE.md" "$REPO_ROOT/.github/copilot-instructions.md"
  echo "[pre-commit] Done."
fi
